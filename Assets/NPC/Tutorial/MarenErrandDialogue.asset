  m_Script: {fileID: 11500000, guid: 184a3f8e5607a4e4cad98f4c2b16111e, type: 3}
  m_Name: MarenErrandDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Maren Ashcombe
  npcPortrait: {fileID: 3295236706101327806, guid: ead51e351fb461443bad0e258fcf1e53, type: 3}
  dialogueLines:
  - You've a knack for arriving when I'm short a pair of hands.
  - The draught for his lungs is done, all but one thing. Bittermoss. It only grows
    where the sun's never been.
  - Past the old stone, where the path gives out, there's a cave mouth. The moss
    lines the rock just inside.
  - Stay where the light reaches. Pick what you need and come straight back.
  - It's that or he doesn't see the week out. I'd go myself if these hands could
    climb.
  - Then be quick deciding. Dusk won't wait on either of us.
  - The cave past the old stone. Just inside. No deeper than the light.
  - You came back. Sometimes I think the well listens when I worry.
  autoProgressLines: 0000010001000000
  endDialogueLines: 0000000100010101
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  voiceSound: {fileID: 8300000, guid: 7681bdf5cab94674b97f809070794f89, type: 3}
  voicePitch: 1.05
  choices:
  - dialogueIndex: 2
    choices:
    - I'll fetch it.
    - The cave? At this hour?
    nextDialogueIndexes: 0300000004000000
    givesQuest: 0100
  - dialogueIndex: 4
    choices:
    - I'll fetch it.
    - Not yet.
