  m_Name: SedgeDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Oldmother Sedge
  npcPortrait: {fileID: 3295236706101327806, guid: 5e235b71ae2b2e049a705d996ea47675, type: 3}
  dialogueLines:
  - You walk loud. The path forgives it. The wood won't.
  - Ask your question or don't. The stone hears either way.
  - The dead go down. Down is not away.
  - Go on, then. Dusk is patient. You aren't.
