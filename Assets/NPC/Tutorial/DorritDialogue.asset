  m_Script: {fileID: 11500000, guid: 184a3f8e5607a4e4cad98f4c2b16111e, type: 3}
  m_Name: DorritDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Dorrit
  npcPortrait: {fileID: 3295236706101327806, guid: 871957f040a113d44846c37c789e87cd, type: 3}
  dialogueLines:
  - Can't stop! He's GETTING AWAY.
  - Sir Feathers! He bit the priest once. It was the best day. But now he's got my
    button.
  - Brass one, off Ma's coat. He's CARRYING it. Get it back? I'll pay a whole copper.
  - You have to be sneaky. He respects sneaky.
  - It's a BRASS one. From Ma's COAT.
  - Fine. Me and him will settle it the old way. Running.
  - He stops to gloat at the corners. That's when you grab it!
  - MY BUTTON! You're my second favourite person now. First is still the goose.
  autoProgressLines: 0000010001000000
  endDialogueLines: 0000000100010101
  autoProgressDelay: 1.5
  typingSpeed: 0.05
