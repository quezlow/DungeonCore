  m_Name: PellDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Pell
  npcPortrait: {fileID: 3295236706101327806, guid: d923732ed58593549a18809b5c991ec4, type: 3}
  dialogueLines:
  - Relax. If I'd taken it, you'd still be smiling.
  - 'Since you''re upright and idle: the junk twin outside holds a coil of rope for
    us. Fetch it, earn a copper honestly. Novel feeling.'
  - Quick about it. We move at dusk.
  - And be seen hauling rope through town? I've a reputation to underachieve.
  - Suit yourself. Doors open either way. Some just need persuading.
  - Tally's stall. Say it's for the corner table. She'll grumble, she'll hand it
    over.
  - Good rope. It'll hold a man's weight easy. ...What? It's a compliment to the
    rope.
  autoProgressLines: 00010001000000
  endDialogueLines: 00000100010101
  autoProgressDelay: 1.5
  typingSpeed: 0.05
