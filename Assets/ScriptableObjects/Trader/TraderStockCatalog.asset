    isCatchUp: 0
  - id: bk_breath
    displayName: The Drawn Breath
    type: 1
    pattern: {fileID: 0}
    nodeKey: tech.drawn_breath
    unlockKey: 
    chargeSpell: {fileID: 0}
    chargeCount: 1
    minRegard: 0
    price: 400
    flavour: On the closing of wounds in things that were never quite alive. The
      author signs off mid-sentence.
    isCatchUp: 0
