--- !u!114 &488369370
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 488369369}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d514dd94794bab44b7926dafce2fd5c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeathSequenceController
  lines:
  - speakerName: Pell
    portrait: {fileID: 3295236706101327806, guid: d923732ed58593549a18809b5c991ec4, type: 3}
    text: Told you I heard steps. It's the errand runner. Following us now, are you?
    holdSeconds: 3
  - speakerName: Mott
    portrait: {fileID: 3295236706101327806, guid: 538f5e40652dd5f4d829b4d9e71590f1, type: 3}
    text: They're here for moss. Look at their hands. Moss, Serra. That's all this
      is.
    holdSeconds: 3
  - speakerName: Serra
    portrait: {fileID: 3295236706101327806, guid: 4e12a982a183b384ebf5663934cd04c0, type: 3}
    text: The seal is open, Mott. They are standing in front of an open seal.
    holdSeconds: 3
  - speakerName: Pell
    portrait: {fileID: 3295236706101327806, guid: d923732ed58593549a18809b5c991ec4, type: 3}
    text: Why did you have to come down here? Why did you... stay back. STAY BACK.
    holdSeconds: 3.2
  - speakerName: Mott
    portrait: {fileID: 3295236706101327806, guid: 538f5e40652dd5f4d829b4d9e71590f1, type: 3}
    text: Pell, no! No no no...
    holdSeconds: 2.2
  - speakerName: Serra
    portrait: {fileID: 3295236706101327806, guid: 4e12a982a183b384ebf5663934cd04c0, type: 3}
    text: ...Half a job. Gods.
    holdSeconds: 2.4
  - speakerName: Serra
    portrait: {fileID: 3295236706101327806, guid: 4e12a982a183b384ebf5663934cd04c0, type: 3}
    text: Close your eyes. The dark takes care of the rest...
    holdSeconds: 3.5
  fadeOnLinesFromEnd: 1
  fadeOutSeconds: 2.5
  awakeningGroup: {fileID: 1198435014}
  awakeningText: {fileID: 573141560}
  lineFadeSeconds: 0.8
  lineHoldSeconds: 3.2
  blackHoldSeconds: 2
